# .env.example — Khôi phục lại sau khi mất file .env thật (07/2026)
#
# File này liệt kê ĐẦY ĐỦ tên biến môi trường được code trong repo tham chiếu tới
# (quét bằng `grep -rhoE "os\.(getenv|environ\.get)\(['\"][A-Z_]+"` trên toàn bộ
# graph/**/*.py, server/**/*.py). GIÁ TRỊ THẬT (API key...) không lấy lại được qua
# git vì file .env gốc chưa từng được git track ở trạng thái gần đây — bạn cần tự
# điền lại từ nơi bạn đã đăng ký (NVIDIA NGC/build.nvidia.com, v.v.).
#
# Copy file này thành `.env` (bỏ đuôi .example), điền giá trị thật, rồi restart
# `langgraph up`.

# ── LangGraph CLI (langgraph up) — KHÔNG nằm trong code Python của bạn, do chính
# binary `langgraph` CLI tự đọc trực tiếp, nên lần quét os.getenv() trước bị bỏ sót.
# Lấy tại: smith.langchain.com -> Settings -> API Keys.
LANGSMITH_API_KEY= # BẮT BUỘC để `langgraph up` chạy được (local dev)

# ── Postgres (checkpointer) ──
# LƯU Ý: langgraph-override.yml đã HARDCODE sẵn biến DATABASE_URI (chú ý: URI,
# không phải URL) trực tiếp trong file đó — KHÔNG đọc từ .env. Biến DATABASE_URL
# dưới đây là TÊN KHÁC, chỉ dùng cho 1 nhánh dự phòng riêng trong
# graph/graph_builder.py (os.getenv("DATABASE_URL")) — không bắt buộc phải có,
# điền cho chắc/đồng bộ thôi:
DATABASE_URL=postgresql://sf_user:sf_pass@127.0.0.1:5433/softwarefactory?sslmode=disable

# Không bắt buộc — docker-compose.yml đã có default sẵn khớp đúng giá trị trên
# (sf_user/sf_pass/softwarefactory), chỉ cần điền nếu muốn ĐỔI khác đi:
# POSTGRES_USER=sf_user
# POSTGRES_PASSWORD=sf_pass
# POSTGRES_DB=softwarefactory

# ── NVIDIA NIM (provider LLM mặc định toàn hệ thống) ──
# BẮT BUỘC — điền lại key thật của bạn
NVIDIA_API_KEY=

# BẮT BUỘC nếu dùng engineer_node — điền lại key thật
OPENHANDS_LLM_API_KEY= # BẮT BUỘC nếu dùng engineer_node — điền lại key thật

# có default trong code, điền lại cho chắc
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# có default trong code, điền lại cho chắc
NVIDIA_MODEL=openai/gpt-oss-120b

# ── Override LLM chung (nếu dùng, không bắt buộc — code tự fallback về NVIDIA_* nếu để trống) ──
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# ── Override provider riêng từng node (không bắt buộc, để trống = dùng mặc định) ──
BA_PROVIDER=
PRD_PROVIDER=
DESIGN_PROVIDER=
UI_PROVIDER=

# ── ba_node — nhánh agentic (OpenHands/OpenCode), thêm gần đây ──
# để trống = fallback dùng NVIDIA_API_KEY / NVIDIA_API_BASE / NVIDIA_MODEL
# true để bật agent thật (OpenHands/OpenCode) thay vì llm.call() đơn thuần
# openhands_text | opencode
BA_USE_AGENT=true
PRD_USE_AGENT=true
DESIGN_USE_AGENT=true
DESIGN_TOKENS_USE_AGENT=true
ENGINEER_USE_AGENT=true
UI_USE_AGENT=true
BA_AGENT_RUNTIME=opencode
BA_LLM_API_KEY=
BA_LLM_BASE_URL=
BA_LLM_MODEL=
BA_MAX_ITERATIONS=30

# ── prd_node — nhánh agentic (OpenCode), thêm gần đây ──
PRD_USE_AGENT=true
PRD_AGENT_RUNTIME=opencode
PRD_LLM_API_KEY=
PRD_LLM_BASE_URL=
PRD_LLM_MODEL=
PRD_MAX_ITERATIONS=30

# ── engineer_node (OpenHands SDK, chạy in-process trong container) ──
OPENHANDS_LLM_API_KEY= # BẮT BUỘC nếu dùng engineer_node — điền lại key thật

# ── Khác ──
# ── Khác ──
MAX_HISTORY_VERSIONS=30


N_DEBATE = 3


PRD_USE_BMAD_SKILL=true
UX_USE_BMAD_SKILL=true
DESIGN_USE_BMAD_SKILL=true
ENGINEER_USE_BMAD_SKILL = true